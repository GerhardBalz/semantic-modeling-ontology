@prefix smo: <https://github.com/GerhardBalz/semantic-modeling-ontology#> .
@prefix smox: <https://github.com/GerhardBalz/semantic-modeling-ontology/examples/self-description#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The ontology is described as an instance of the Model class that it defines.

<https://github.com/GerhardBalz/semantic-modeling-ontology>
    a owl:Ontology, smo:Model ;
    dcterms:title "Semantic Modeling Ontology"@en ;
    smo:hasModelKind smo:OntologyModelKind ;
    smo:usesLanguage smo:RDF, smo:RDFS, smo:OWL, smo:SHACL, smo:SKOS ;
    smo:hasRepresentation smox:OntologyTurtle, smox:ArchitectureDocument, smox:ShapeGraph ;
    smo:hasConstraint smo:ModelShape ;
    smo:containsElement
        smo:Model,
        smo:ModelElement,
        smo:ModelKind,
        smo:ModelingLanguage,
        smo:ModelRepresentation,
        smo:SemanticView,
        smo:Constraint,
        smo:Mapping,
        smo:Transformation,
        smo:Artifact,
        smo:RuntimeContext,
        smo:AgentContract .

# Concrete representations of the model.

smox:OntologyTurtle
    a smo:ModelRepresentation ;
    dcterms:title "Semantic Modeling Ontology — Turtle representation"@en ;
    dcterms:format "text/turtle" ;
    dcterms:identifier "ontology/semantic-modeling.ttl" .

smox:ArchitectureDocument
    a smo:ModelRepresentation ;
    dcterms:title "Semantic Modeling Ontology — architecture document"@en ;
    dcterms:format "text/markdown" ;
    dcterms:identifier "docs/architecture.md" .

smox:ShapeGraph
    a smo:ModelRepresentation ;
    dcterms:title "Semantic Modeling Ontology — SHACL shapes"@en ;
    dcterms:format "text/turtle" ;
    dcterms:identifier "shapes/semantic-modeling-shapes.ttl" .

# OWL 2 punning is used here deliberately: each resource is both an OWL class
# and an individual model element in the ontology's self-description.

smo:Model a smo:ModelElement .
smo:ModelElement a smo:ModelElement .
smo:ModelKind a smo:ModelElement .
smo:ModelingLanguage a smo:ModelElement .
smo:ModelRepresentation a smo:ModelElement .
smo:SemanticView a smo:ModelElement .
smo:Constraint a smo:ModelElement .
smo:Mapping a smo:ModelElement .
smo:Transformation a smo:ModelElement .
smo:Artifact a smo:ModelElement .
smo:RuntimeContext a smo:ModelElement .
smo:AgentContract a smo:ModelElement .

# The SHACL node shape is also described as a semantic constraint.

smo:ModelShape
    a smo:Constraint ;
    rdfs:label "Model shape"@en .
